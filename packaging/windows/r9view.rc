#include <windows.h>

// Icon id 1 so it is the lowest-numbered icon in the binary, which is the one
// Explorer picks up for the file and the shell shows on shortcuts.
1 ICON "r9view.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rhineul Islam"
            VALUE "FileDescription",  "r9view -- image and comic viewer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "r9view"
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
            VALUE "OriginalFilename", "r9view.exe"
            VALUE "ProductName",      "r9view"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
